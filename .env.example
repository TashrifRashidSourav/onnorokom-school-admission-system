# Copy to .env to override the defaults used by docker-compose.yml.
# docker compose up works without a .env file.

# PostgreSQL
POSTGRES_DB=admission
POSTGRES_USER=admission
POSTGRES_PASSWORD=admission

# Backend
HOLD_DURATION_SECONDS=600
# How often expired holds are saved as EXPIRED; 0 switches this off (seats are still freed on time)
EXPIRY_SWEEP_SECONDS=5
# Most database connections one backend process may open (PostgreSQL allows 100 in total)
DB_POOL_SIZE=40

# Frontend: URL the browser uses to reach the backend
API_URL=http://localhost:8080

# Host ports (change if something else already uses them)
DB_PORT=5432
BACKEND_PORT=8080
# Second backend process, only with: docker compose --profile multi up -d
BACKEND2_PORT=8081
FRONTEND_PORT=3000
