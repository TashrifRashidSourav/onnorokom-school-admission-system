# Copy to .env to override the defaults used by docker-compose.yml.
# docker compose up works without a .env file.

# PostgreSQL
POSTGRES_DB=admission
POSTGRES_USER=admission
POSTGRES_PASSWORD=admission

# Backend
HOLD_DURATION_SECONDS=600

# Frontend: URL the browser uses to reach the backend
API_URL=http://localhost:8080

# Host ports (change if something else already uses them)
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
